---
// Colonne infinie de toiles (le WebGL est piloté par src/motion/carousel.ts).
// Le DOM est le repli sans WebGL et la source des textures.
import { Image, getImage } from 'astro:assets';
import type { Slide } from '../data/site';
interface Props { slides: Slide[]; title: string; label: string; side: string }
const { slides, title, label, side } = Astro.props;
// Texture WebGL de chaque toile : une seule taille, chargée par la colonne quand la toile approche.
const tex = await Promise.all(slides.map((s) => getImage({ src: s.src, width: Math.min(1200, s.src.width), format: 'webp' })));
---
<section class="stage" data-carousel aria-label={label}>
  <h1 class="sr-only">{title}</h1>

  <ol class="reel">
    {slides.map((s, i) => (
      <li>
        <button type="button" data-label={s.label} data-note={s.note} data-ratio={String(s.src.width / s.src.height)} data-tex={tex[i].src}>
          <Image src={s.src} alt={s.alt} widths={[640, Math.min(1400, s.src.width)]} sizes="(max-width: 767px) 84vw, 48vw" loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
          <span class="reel__label">{s.label}<span class="reel__note">{s.note}</span></span>
        </button>
      </li>
    ))}
  </ol>

  <div class="pluses" data-pluses></div>

  <div class="caption" aria-hidden="true">
    <span class="caption__clip caption__note"><span data-cap-note>{slides[0].note}</span></span>
    <span class="caption__clip caption__label"><span data-cap-label>{slides[0].label}</span></span>
  </div>
  <p class="sr-only" aria-live="polite" data-live></p>

  <p class="side side--l" aria-hidden="true">{side}</p>

  <button type="button" class="zoom-close" data-zoom-close aria-label="Fermer le zoom"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></button>
</section>
