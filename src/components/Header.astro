---
import { site } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Accueil', current: path === '/' },
  { href: '/nouvelles-toiles/', label: '2021 à aujourd’hui', current: path.startsWith('/nouvelles-toiles') },
  { href: '/2018-2020/', label: '2018-2020', current: path.startsWith('/2018-2020') },
  { href: '/old-works/', label: '2013-2017', current: path.startsWith('/old-works') },
];
---
<header class="frame">
  <a class="frame__name" href="/">{site.name}</a>
  <button type="button" class="menu-btn" data-menu-open aria-expanded="false" aria-controls="menu">Menu</button>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <button type="button" class="menu__close" data-menu-close aria-label="Fermer le menu"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/></svg></button>
    <nav aria-label="Pages">
      <ol class="menu__list">
        {links.map((l) => (
          <li><a class="menu__link" href={l.href} aria-current={l.current ? 'page' : undefined}><span class="menu__text">{l.label}</span></a></li>
        ))}
      </ol>
    </nav>
    <ul class="menu__meta">
      <li><a href={`mailto:${site.email}`}>Écrire</a></li>
      {site.socials.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
    </ul>
  </div>
</div>
